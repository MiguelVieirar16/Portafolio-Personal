---
import Layout from "@/layouts/Layout.astro"
---

<Layout
  title="Miguel Vieira"
  description="Canal de pacientes para consultorios. Portafolio de producto."
  tone="brown"
>
  <main class="mx-auto max-w-5xl px-5 pb-24 pt-10 sm:px-8 sm:pt-16">
    <h1 class="font-display text-4xl tracking-tight text-ink sm:text-5xl">
      Miguel Vieira
    </h1>
    <p class="mt-3 max-w-md text-ink-muted">Producto. Dos puertas.</p>

    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      <a
        href="/consultorios"
        class="group flex min-h-44 flex-col justify-between rounded-xl border border-line bg-paper-elevated p-6"
      >
        <svg class="size-6 text-forest" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 3v12M18 3v12M6 9h12M8 21h8M12 15v6" />
        </svg>
        <div class="mt-8 flex items-end justify-between gap-4">
          <div>
            <h2 class="font-display text-2xl">Consultorios</h2>
            <p class="mt-1 text-sm text-ink-muted">
              Canal de pacientes: página, Google, WhatsApp.
            </p>
          </div>
          <span class="text-ink-subtle">↗</span>
        </div>
      </a>

      <a
        href="/trabajo"
        class="group flex min-h-44 flex-col justify-between rounded-xl border border-line bg-paper-elevated p-6"
      >
        <svg class="size-6 text-forest" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V5a2 2 0 012-2h4a2 2 0 012 2v2M4 7h16v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7z" />
        </svg>
        <div class="mt-8 flex items-end justify-between gap-4">
          <div>
            <h2 class="font-display text-2xl">Trabajo</h2>
            <p class="mt-1 text-sm text-ink-muted">Experiencia y proyectos.</p>
          </div>
          <span class="text-ink-subtle">↗</span>
        </div>
      </a>
    </div>
  </main>
</Layout>
