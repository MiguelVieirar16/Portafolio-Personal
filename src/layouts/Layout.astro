---
import "@fontsource-variable/onest"

import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { ViewTransitions } from "astro:transitions"

interface Props {
  title: string
  description: string
  tone?: "brown" | "blue"
}

const { description, title, tone = "blue" } = Astro.props
const brown = tone === "brown"
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      const __lang = localStorage.getItem("lang") || "es"
      document.documentElement.setAttribute("lang", __lang)
    </script>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      brown && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600&display=swap"
            rel="stylesheet"
          />
        </>
      )
    }
    <ViewTransitions />
  </head>

  <body class:list={["relative", brown ? "bg-paper text-ink" : "text-black"]}>
    {
      !brown && (
        <div class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-[#f8fafc] bg-[linear-gradient(to_bottom,transparent,rgba(37,99,235,0.07))]" />
      )
    }
    <Header tone={tone} />
    <slot />
    {tone === "blue" && <Footer />}
    <style is:global>
      html {
        font-family: "Onest Variable", system-ui, sans-serif;
        scroll-behavior: smooth;
      }

      body {
        color: rgba(17, 17, 17, 0.9);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overscroll-behavior: none;
      }

      body.bg-paper {
        font-family: "Source Sans 3", system-ui, sans-serif;
        color: #1c1917;
      }

      .font-display {
        font-family: "Fraunces", "Times New Roman", serif;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
