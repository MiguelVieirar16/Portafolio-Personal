---
interface Props {
  tone?: "brown" | "blue"
}

const { tone = "blue" } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const blue = tone === "blue"

const links = [
  { title: "Inicio", url: "/", exact: true },
  { title: "Consultorios", url: "/consultorios", exact: false },
  { title: "Trabajo", url: "/trabajo", exact: false },
]
---

<header
  class:list={[
    "sticky top-0 z-20 h-14",
    blue
      ? "border-b border-slate-200 bg-white/90 backdrop-blur"
      : "border-b border-line bg-paper/90 backdrop-blur",
  ]}
>
  <nav class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-3 px-5 sm:px-8">
    <div class="flex h-14 items-center gap-1 text-sm font-medium">
      {
        links.map((link) => {
          const active = link.exact ? path === link.url : path.startsWith(link.url)
          return (
            <a
              href={link.url}
              class:list={[
                "inline-flex h-14 items-center px-3",
                blue
                  ? active
                    ? "text-blue-600"
                    : "text-slate-500 hover:text-blue-600"
                  : active
                    ? "text-ink"
                    : "text-ink-muted hover:text-ink",
              ]}
            >
              {link.title}
            </a>
          )
        })
      }
    </div>
    <a
      href="mailto:hola@vieirarmiguel.com"
      class:list={[
        "inline-flex h-9 items-center rounded-md px-3.5 text-sm font-medium",
        blue ? "bg-blue-600 text-white" : "bg-forest text-forest-fg",
      ]}
    >
      Escribir
    </a>
  </nav>
</header>
