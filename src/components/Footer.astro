>
  <div
    class="rounded-lg w-full mx-auto md:flex md:items-center md:justify-between py-4"
  >
    <span class="text-sm sm:text-center text-zinc-800/90"
      >© {currentYear}
      <a href="/" class="hover:underline">Miguel Vieira</a>
    </span>
    <ul class="flex flex-wrap items-center mt-3 text-sm font-medium sm:mt-0">
      <li>
        <a href="/consultorios" class="hover:underline me-4 md:me-6">Consultorios</a>
      </li>
      <li>
        <a href="/trabajo" class="hover:underline me-4 md:me-6">Trabajo</a>
      </li>
      <li>
        <a id="contacto" href="mailto:hola@vieirarmiguel.com" class="hover:underline">hola@vieirarmiguel.com</a>
